# ─────────────────────────────────────────────────────
# PesaPilot — Environment Variables
# Fill in your keys, then rename this file to .env
# Never commit .env to GitHub
# ─────────────────────────────────────────────────────

# ============================================================
# PostgreSQL — Self-hosted database (local or VPS)
# ============================================================
# Two ways to configure the connection — pick ONE:
#
# OPTION A — separate pieces (what you're using): the app builds the
# connection string for you from these. Host and port are optional and
# default to localhost:5432 if omitted.
POSTGRES_USER=Moses
POSTGRES_PASSWORD=1234
POSTGRES_DB=pesapilpt_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
#
# OPTION B — one connection string instead of the four lines above.
# If DATABASE_URL is set, it's used as-is and the POSTGRES_* lines above
# are ignored — leave DATABASE_URL blank/commented out to use Option A.
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=postgresql://Moses:3749@localhost:5432/pesapilpt_db

# ============================================================
# Groq — console.groq.com → API Keys
# ============================================================
GROQ_API_KEY=gsk_your-groq-api-key-here

# ============================================================
# App Configuration
# ============================================================
APP_ENV=production
DEBUG=false
SECRET_KEY=your-32-character-secret-key-here

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info

# ============================================================
# Database Configuration (auto-managed by PostgresDB class)
# ============================================================
# DB_MAX_CONNECTIONS — max concurrent connections (default: 10)
# DB_CONNECTION_TIMEOUT — connection timeout in seconds (default: 30)


# ============================================================
# LLM / AI Configuration
# ============================================================
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_TEMPERATURE=0.6
# The reasoning pass shares this token budget with the visible answer.
LLM_MAX_TOKENS=1536
# Reasoning effort for openai/gpt-oss-* models: low, medium, or high
LLM_REASONING_EFFORT=low
CACHE_TTL=300
API_TIMEOUT=20

# ============================================================
# WhatsApp Configuration
# ============================================================
# Your main Safaricom number — the number you send questions FROM
# Format: country code + number, no + sign (e.g. 254712345678)
WHATSAPP_MAIN_NUMBER=254712345678

# Your WhatsApp LID — internal ID WhatsApp assigns to your number
# To find it: run the bot, send a message, copy the value printed next to "From:" in the terminal
WHATSAPP_LID=

# Your WhatsApp PIN — used for manual SMS entry (PIN-SMS_CONTENT)
WHATSAPP_PIN=1234

# ============================================================
# API Configuration
# ============================================================
API_URL=http://127.0.0.1:8000
WHATSAPP_API_PORT=8000

# ============================================================
# Node.js Configuration
# ============================================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048

# ============================================================
# Python Configuration
# ============================================================
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ============================================================
# Puppeteer/Google Chrome Configuration
# ============================================================
# PUPPETEER_SKIP_DOWNLOAD is the var name current puppeteer versions
# actually read. Set it in your real shell/CI environment before running
# `npm install` — this file is NOT loaded at install time, only at app
# runtime — or the install will try to download Chrome and fail.
PUPPETEER_SKIP_DOWNLOAD=true
# Kept for older puppeteer versions / back-compat, harmless either way
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# ============================================================
# Timezone
# ============================================================
TZ=Africa/Nairobi

# ============================================================
# WhatsApp Library Configuration
# ============================================================
WHATSAPP_USE_PAIRING_CODE=false
BAILEYS_AUTH_PATH=./.baileys_auth
BAILEYS_LOG_LEVEL=info
WWEBJS_AUTH_PATH=./.wwebjs_auth