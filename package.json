{
  "name": "pesapilot",
  "version": "1.4.0",
  "description": "AI-powered M-Pesa financial assistant. Parses your SMS transaction history, stores it in a self-hosted PostgreSQL database, and gives you real-time spending insights powered by Groq AI.",
  "main": "dist/whatsapp_bot.js",
  "scripts": {
    "start": "node dist/whatsapp_bot.js",
    "start:wwebjs": "node whatsapp/whatsapp_bot.js",
    "dev": "tsx watch whatsapp/whatsapp_bot.ts",
    "dev:wwebjs": "node --watch whatsapp/whatsapp_bot.js",
    "build": "tsc",
    "postbuild": "echo '{\"type\":\"module\"}' > dist/package.json",
    "build:watch": "tsc --watch",
    "api": "python -m uvicorn whatsapp.whatsapp_api:app --host 127.0.0.1 --port 8000",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist ./.baileys_auth ./.wwebjs_auth",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosesamwoma/PesaPilot.git"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "mpesa",
    "ai",
    "groq",
    "financial",
    "baileys",
    "whatsapp-web.js",
    "typescript"
  ],
  "author": "Moses Amwoma",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mosesamwoma/PesaPilot/issues"
  },
  "homepage": "https://github.com/mosesamwoma/PesaPilot#readme",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "puppeteer": "^25.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "whatsapp-web.js": "^1.34.8"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "@puppeteer/browsers": "3.2.7",
    "zod": "^4.6.6",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  }
}
