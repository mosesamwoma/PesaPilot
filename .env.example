# ─────────────────────────────────────────────────────
# PesaPilot — Environment Variables
#
# Easiest: run  scripts/generate_secrets.sh  — it creates .env from this file
# with fresh random POSTGRES_PASSWORD, API_TOKEN and WHATSAPP_PIN (mode 600).
# Then add your GROQ_API_KEY and WHATSAPP_MAIN_NUMBER.
#
# Variables marked REQUIRED are intentionally empty here: the app refuses to
# start with empty or "change-me" style values. Never commit .env.
# ─────────────────────────────────────────────────────

# ============================================================
# PostgreSQL — Self-hosted database (local or VPS)
# ============================================================
# The app builds the connection string for you from these separate
# pieces. Port is optional and defaults to 5432 if omitted.
#
# POSTGRES_HOST=auto (the default, and what's set below) makes this ONE
# .env file work unmodified whether you run PesaPilot on bare metal,
# in Docker, or in Podman — src/database.py checks for /.dockerenv and
# /run/.containerenv at startup and picks the right host for you:
#   - bare metal  -> 127.0.0.1
#   - Docker      -> host.docker.internal (needs the extra_hosts entry
#                    already in docker-compose.yml on Linux; falls back
#                    to 172.17.0.1 automatically if that doesn't resolve)
#   - Podman      -> host.containers.internal
#
# Set POSTGRES_HOST to an explicit hostname/IP instead of "auto" if
# Postgres runs somewhere else entirely, e.g. a remote VPS.
POSTGRES_USER=pesapilot
# REQUIRED — random; apply it to the database with scripts/setup_db.sh
POSTGRES_PASSWORD=
POSTGRES_DB=pesapilot
POSTGRES_HOST=auto
POSTGRES_PORT=5432
# Optional: require TLS to a remote database (disable | require | verify-full)
# POSTGRES_SSLMODE=require

# ============================================================
# Groq — console.groq.com → API Keys
# ============================================================
# REQUIRED
GROQ_API_KEY=

# ============================================================
# LLM / AI Configuration
# ============================================================
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_TEMPERATURE=0.6
# The reasoning pass shares this token budget with the visible answer.
LLM_MAX_TOKENS=1536
# Reasoning effort for openai/gpt-oss-* models: low, medium, or high
LLM_REASONING_EFFORT=low
API_TIMEOUT=20

# ============================================================
# WhatsApp Configuration
# ============================================================
# Your main Safaricom number — the number you send questions FROM
# Format: country code + number, no + sign (e.g. 254712345678)
# REQUIRED
WHATSAPP_MAIN_NUMBER=

# Your WhatsApp LID — internal ID WhatsApp assigns to your number (optional at first start)
# To find it: run the bot, send a message, copy the value printed next to "From:" in the terminal,
# paste it here and restart. Until it is set, messages arriving from a linked-device ID are ignored.
WHATSAPP_LID=

# Your WhatsApp PIN — used for manual SMS entry (PIN-SMS_CONTENT)
# REQUIRED — random; send manual entries as PIN-SMS_CONTENT
WHATSAPP_PIN=

# ============================================================
# Scheduled summaries
# ============================================================
# Standard 5-field cron expressions, evaluated in Africa/Nairobi time.
# Leave empty for the defaults below, or set to off to disable a summary.
# Weekly: every Monday 08:00, covering the previous Monday to Sunday.
# Monthly: the 1st of each month at 08:30, covering the previous calendar month.
WEEKLY_SUMMARY_CRON="0 8 * * 1"
MONTHLY_SUMMARY_CRON="30 8 1 * *"

# ============================================================
# API Configuration
# ============================================================
API_URL=http://127.0.0.1:8000
WHATSAPP_API_PORT=8000
# Host the API binds to when run outside a container. The compose files set
# this to 0.0.0.0 inside the container (needed for the port mapping below).
# Keep 127.0.0.1 on bare metal.
API_BIND_HOST=127.0.0.1
# Host interface the compose files publish port 8000 on. Keep 127.0.0.1; to
# reach the API from elsewhere use a TLS reverse proxy (see README), not 0.0.0.0.
API_BIND=127.0.0.1
# REQUIRED — shared secret every API request must send (Authorization: Bearer ...).
# The bot reads the same value. Minimum 24 random characters.
API_TOKEN=
# Optional: password for the Streamlit dashboard (recommended if it is ever reachable by others).
DASHBOARD_PASSWORD=
# Browser origins allowed to call the API, comma-separated full origins
# (scheme, host and port). Leave empty to disable CORS entirely: the bot and
# the dashboard call the API server-side and do not need it.
CORS_ORIGINS=
# Maximum failed authentication attempts allowed per client before it is
# temporarily blocked.
API_AUTH_FAIL_LIMIT=10
# General API and AI endpoint request limits per minute, per client.
API_RATE_LIMIT_PER_MIN=120
API_AI_RATE_LIMIT_PER_MIN=30

# ============================================================
# Node.js Configuration
# ============================================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048

# ============================================================
# Python Configuration
# ============================================================
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ============================================================
# Puppeteer/Google Chrome Configuration
# ============================================================
# PUPPETEER_SKIP_DOWNLOAD is the var name current puppeteer versions
# actually read. Set it in your real shell/CI environment before running
# `npm install` — this file is NOT loaded at install time, only at app
# runtime — or the install will try to download Chrome and fail.
PUPPETEER_SKIP_DOWNLOAD=true
# Kept for older puppeteer versions / back-compat, harmless either way
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# ============================================================
# Timezone
# ============================================================
TZ=Africa/Nairobi

# ============================================================
# WhatsApp Library Configuration
# ============================================================
WHATSAPP_USE_PAIRING_CODE=false
# Keep false: true prints a link that sends your WhatsApp login QR to a third-party service.
WHATSAPP_QR_LINK=false
BAILEYS_AUTH_PATH=./.baileys_auth
BAILEYS_LOG_LEVEL=info
WWEBJS_AUTH_PATH=./.wwebjs_auth