# PesaPilot — Puppeteer/Chromium WhatsApp bot + FastAPI dashboard API
#
# This is the "for fun" Podman counterpart to the Baileys Dockerfile.
# Unlike Baileys, this bot needs a real headless Chromium in the
# image — that's the whole reason this is a separate file and
# not just a flag on the existing one.
#
# Build (Podman):
#   podman build -f Containerfile.podman -t pesapilot-local .
#
# Build (Docker, if you ever want to compare):
#   docker build -f Containerfile.podman -t pesapilot-local .

FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive

# ----------------------------------------------------------------
# Force UTF-8 everywhere (Python, Node, shell, logs) so emojis in
# WhatsApp replies / AI responses / chart titles never get mangled
# ----------------------------------------------------------------
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1

# ----------------------------------------------------------------
# System deps: curl (healthcheck) + fontconfig (chart fonts) +
# Node.js 20.x + Chromium itself (this is the big difference vs
# the Baileys image — this bot drives a real browser).
# ----------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    gnupg \
    fontconfig \
    fonts-noto-color-emoji \
    fonts-dejavu \
    chromium \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && fc-cache -fv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN node --version && npm --version && chromium --version

WORKDIR /app

# ----------------------------------------------------------------
# Entrypoint (already in the repo as a local-dev fallback; this is
# the first thing that actually ships it)
# ----------------------------------------------------------------
COPY entrypoint.wwebjs.sh /app/entrypoint.local.sh
RUN chmod +x /app/entrypoint.local.sh

# ----------------------------------------------------------------
# Python deps
# ----------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ----------------------------------------------------------------
# Node deps
#
# PUPPETEER_SKIP_DOWNLOAD=true still matters here: we install
# Chromium ourselves via apt above (pinned to Debian's build, which
# matches glibc etc. on this base image), so we skip puppeteer's
# own postinstall download of a *second* Chromium and just point it
# at the apt one via PUPPETEER_EXECUTABLE_PATH at runtime.
# ----------------------------------------------------------------
ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY package*.json ./
RUN npm install \
    && npm cache clean --force

# ----------------------------------------------------------------
# App source (no TypeScript build needed — the bot's plain .js runs as-is)
# ----------------------------------------------------------------
COPY src/ ./src/
COPY whatsapp/ ./whatsapp/
COPY run.py .

RUN mkdir -p data/raw data/processed data/sessions \
    && mkdir -p .wwebjs_auth \
    && chmod -R 777 .wwebjs_auth \
    && chmod -R 777 data

ENV NODE_ENV=production
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

ENTRYPOINT ["./entrypoint.local.sh"]